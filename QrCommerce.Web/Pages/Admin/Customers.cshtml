@page
@model QrCommerce.Web.Pages.Admin.CustomersModel
@{
    ViewData["Title"] = "Customers";
}

<form method="get" class="row mb-3">
    <div class="col-md-4">
        <input type="text" name="search" class="form-control" placeholder="Search customers..." value="@Model.Search" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Phone</th>
                <th>Email</th>
                <th>Orders</th>
                <th>Spent</th>
                <th>Last Order</th>
                <th>Location</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model.Customers)
            {
                <tr>
                    <td>@c.Id</td>
                    <td>@c.Name</td>
                    <td>@c.Phone</td>
                    <td>@c.Email</td>
                    <td>@c.TotalOrders</td>
                    <td>@c.TotalSpent.ToString("N0")</td>
                    <td>@(c.LastOrderAt?.ToString("yyyy-MM-dd") ?? "-")</td>
                    <td>@(c.Latitude != 0 ? $"{c.Latitude:F4}, {c.Longitude:F4}" : "-")</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="?page=@i&search=@Model.Search">@i</a></li>
        }
    </ul>
</nav>
