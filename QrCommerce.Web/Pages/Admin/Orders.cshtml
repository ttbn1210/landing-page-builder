@page
@model QrCommerce.Web.Pages.Admin.OrdersModel
@{
    ViewData["Title"] = "Orders";
}

<form method="get" class="row mb-3">
    <div class="col-md-4">
        <input type="text" name="search" class="form-control" placeholder="Search orders..." value="@Model.Search" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Code</th>
                <th>Customer</th>
                <th>Phone</th>
                <th>Location</th>
                <th>Amount</th>
                <th>Status</th>
                <th>Created</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var o in Model.Orders)
            {
                <tr>
                    <td><code>@o.OrderCode</code></td>
                    <td>@o.Customer.Name</td>
                    <td>@o.Customer.Phone</td>
                    <td>@o.QrLocation.Name</td>
                    <td>@o.TotalAmount.ToString("N0")</td>
                    <td><span class="badge bg-@(o.Status == OrderStatus.Completed ? "success" : o.Status == OrderStatus.Cancelled ? "danger" : o.Status == OrderStatus.Preparing ? "info" : "warning")">@o.Status</span></td>
                    <td>@o.CreatedAt.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>
                        @if (o.Status == OrderStatus.Pending)
                        {
                            <form method="post" asp-page-handler="UpdateStatus" style="display:inline">
                                <input type="hidden" name="orderId" value="@o.Id" />
                                <input type="hidden" name="status" value="Confirmed" />
                                <button class="btn btn-sm btn-success">Confirm</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<nav>
    <ul class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.Page ? "active" : "")"><a class="page-link" href="?page=@i&search=@Model.Search">@i</a></li>
        }
    </ul>
</nav>
