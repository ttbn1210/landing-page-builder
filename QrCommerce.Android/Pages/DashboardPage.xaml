<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QrCommerce.Android.Pages.DashboardPage"
             Title="Dashboard">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Frame BackgroundColor="#667eea" CornerRadius="10" Padding="20">
                <VerticalStackLayout>
                    <Label Text="QR Commerce Gateway" FontSize="22" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                    <Label x:Name="StatusLabel" Text="Stopped" FontSize="16" TextColor="White" HorizontalOptions="Center" Margin="0,5,0,0" />
                </VerticalStackLayout>
            </Frame>

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Frame Grid.Row="0" Grid.Column="0" BackgroundColor="#f8f9fa" CornerRadius="8" Padding="15">
                    <VerticalStackLayout>
                        <Label x:Name="BatteryLabel" Text="--%" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Battery" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="0" Grid.Column="1" BackgroundColor="#f8f9fa" CornerRadius="8" Padding="15">
                    <VerticalStackLayout>
                        <Label x:Name="SmsSentLabel" Text="0" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="SMS Sent" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="1" Grid.Column="0" BackgroundColor="#f8f9fa" CornerRadius="8" Padding="15">
                    <VerticalStackLayout>
                        <Label x:Name="PendingLabel" Text="0" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Pending" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Row="1" Grid.Column="1" BackgroundColor="#f8f9fa" CornerRadius="8" Padding="15">
                    <VerticalStackLayout>
                        <Label x:Name="LastSyncLabel" Text="--" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Last Sync" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <Button x:Name="StartStopButton" Text="Start Service" BackgroundColor="#28a745" TextColor="White" FontAttributes="Bold" CornerRadius="8" HeightRequest="50" Clicked="OnStartStopClicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
