@page
@model TrackQR.Web.Pages.LandingPages.CreateModel
@{
    ViewData["Title"] = "Create Landing Page";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card form-card">
            <h4 class="mb-4">Create Landing Page</h4>
            <form method="post">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Page Name</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Template</label>
                        <select asp-for="TemplateType" class="form-select" asp-items="Html.GetEnumSelectList<TemplateType>()"></select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">HTML Content</label>
                    <textarea asp-for="HtmlContent" class="form-control font-monospace" rows="15"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">CSS Content</label>
                    <textarea asp-for="CssContent" class="form-control font-monospace" rows="8"></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create Page</button>
                    <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
