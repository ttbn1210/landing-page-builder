@page "{id:guid}"
@model TrackQR.Web.Pages.LandingPages.EditModel
@{
    ViewData["Title"] = "Edit Landing Page";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card form-card">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h4 class="mb-0">Edit Landing Page</h4>
                @if (Model.Status != LandingPageStatus.Published)
                {
                    <form method="post" asp-page-handler="Publish">
                        <input type="hidden" asp-for="Id" />
                        <button type="submit" class="btn btn-success btn-sm">
                            <i class="fas fa-globe me-1"></i> Publish
                        </button>
                    </form>
                }
                else
                {
                    <span class="badge bg-success">Published</span>
                }
            </div>
            <form method="post">
                <input type="hidden" asp-for="Id" />
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Page Name</label>
                        <input asp-for="Name" class="form-control" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Status</label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<LandingPageStatus>()"></select>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">HTML Content</label>
                    <textarea asp-for="HtmlContent" class="form-control font-monospace" rows="15"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">CSS Content</label>
                    <textarea asp-for="CssContent" class="form-control font-monospace" rows="8"></textarea>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                    <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
