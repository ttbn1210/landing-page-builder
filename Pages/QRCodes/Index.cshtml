@page
@model TrackQR.Web.Pages.QRCodes.IndexModel
@{
    ViewData["Title"] = "QR Codes";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div></div>
    <a asp-page="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i> Generate QR Code</a>
</div>

<div class="card table-card">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Short Code</th>
                    <th>Campaign</th>
                    <th>Placement</th>
                    <th>Landing Page</th>
                    <th>Status</th>
                    <th>Scans</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var qr in Model.QRCodes)
                {
                    <tr>
                        <td><code>@qr.ShortCode</code></td>
                        <td>@qr.Campaign.Name</td>
                        <td>@qr.Placement.Name</td>
                        <td>@qr.LandingPage.Name</td>
                        <td>
                            <span class="badge bg-@(qr.IsActive ? "success" : "danger")">
                                @(qr.IsActive ? "Active" : "Disabled")
                            </span>
                        </td>
                        <td>@qr.VisitorSessions.Count</td>
                        <td>
                            <a asp-page="Details" asp-route-id="@qr.Id" class="btn btn-sm btn-outline-info">
                                <i class="fas fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
