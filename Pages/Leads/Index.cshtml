@page
@model TrackQR.Web.Pages.Leads.IndexModel
@{
    ViewData["Title"] = "Leads";
}

<div class="row g-3 mb-4">
    <div class="col-auto">
        <a asp-page="Index" class="btn btn-sm @(Model.FilterStatus == null ? "btn-primary" : "btn-outline-primary")">All</a>
    </div>
    @foreach (var status in Enum.GetValues<LeadStatus>())
    {
        <div class="col-auto">
            <a asp-page="Index" asp-route-status="@status" class="btn btn-sm @(Model.FilterStatus == status ? "btn-primary" : "btn-outline-primary")">@status</a>
        </div>
    }
</div>

<div class="card table-card">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Phone Number</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Score</th>
                    <th>Source</th>
                    <th>Created</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var lead in Model.Leads)
                {
                    <tr>
                        <td><strong>@(lead.FullName ?? "-")</strong></td>
                        <td>@(string.IsNullOrEmpty(lead.PhoneNumber) ? "-" : lead.PhoneNumber)</td>
                        <td>@(lead.Email ?? "-")</td>
                        <td>
                            <span class="badge badge-status bg-@GetStatusColor(lead.Status)">@lead.Status</span>
                        </td>
                        <td>
                            <div class="progress" style="width: 60px; height: 8px;">
                                <div class="progress-bar" style="width: @lead.Score%"></div>
                            </div>
                            <small>@lead.Score</small>
                        </td>
                        <td>@lead.Session?.QRCode?.Campaign?.Name</td>
                        <td>@DateTimeHelper.ToRelativeTime(lead.CreatedAt)</td>
                        <td>
                            <a asp-page="Details" asp-route-id="@lead.Id" class="btn btn-sm btn-outline-info">
                                <i class="fas fa-eye"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    string GetStatusColor(LeadStatus status) => status switch
    {
        LeadStatus.New => "primary",
        LeadStatus.Contacted => "info",
        LeadStatus.Interested => "warning",
        LeadStatus.Appointment => "success",
        LeadStatus.Converted => "success",
        LeadStatus.Lost => "danger",
        _ => "secondary"
    };
}
