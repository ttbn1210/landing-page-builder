@page "{id:guid}"
@model TrackQR.Web.Pages.Leads.DetailsModel
@{
    ViewData["Title"] = $"Lead: {Model.Lead?.FullName ?? "Unknown"}";
}

@if (Model.Lead == null)
{
    <div class="alert alert-warning">Lead not found.</div>
    return;
}

<div class="row g-4">
    <div class="col-md-5">
        <div class="card form-card">
            <h5 class="mb-3">Lead Information</h5>
            <table class="table table-sm">
                <tr><td class="fw-bold">Name</td><td>@(Model.Lead.FullName ?? "-")</td></tr>
                <tr><td class="fw-bold">Phone</td><td>@(string.IsNullOrEmpty(Model.Lead.PhoneNumber) ? "-" : Model.Lead.PhoneNumber)</td></tr>
                <tr><td class="fw-bold">Email</td><td>@(string.IsNullOrEmpty(Model.Lead.Email) ? "-" : Model.Lead.Email)</td></tr>
                <tr><td class="fw-bold">Form Name</td><td>@(Model.Lead.FormName ?? "-")</td></tr>
                <tr><td class="fw-bold">Form Type</td><td>@(Model.Lead.FormType ?? "-")</td></tr>
                <tr><td class="fw-bold">Score</td><td>@Model.Lead.Score / 100</td></tr>
                <tr><td class="fw-bold">Created</td><td>@Model.Lead.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td></tr>
            </table>

            <h6 class="mt-4">Update Status</h6>
            <form method="post" asp-page-handler="UpdateStatus">
                <input type="hidden" asp-for="Lead.Id" name="leadId" />
                <div class="input-group">
                    <select name="newStatus" class="form-select">
                        @foreach (var status in Enum.GetValues<LeadStatus>())
                        {
                            <option value="@status" selected="@(status == Model.Lead.Status)">@status</option>
                        }
                    </select>
                    <button type="submit" class="btn btn-primary">Update</button>
                </div>
            </form>
        </div>
    </div>
    <div class="col-md-7">
        <div class="card table-card">
            <div class="card-header">Activity Log</div>
            <div class="card-body">
                @if (Model.Lead.Activities.Any())
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var activity in Model.Lead.Activities.OrderByDescending(a => a.CreatedAt))
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <div>
                                    <strong>@activity.Action</strong>
                                    @if (!string.IsNullOrEmpty(activity.Notes))
                                    {
                                        <br /><small class="text-muted">@activity.Notes</small>
                                    }
                                </div>
                                <small class="text-muted">@DateTimeHelper.ToRelativeTime(activity.CreatedAt)</small>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <p class="text-muted text-center">No activity yet</p>
                }

                <form method="post" asp-page-handler="AddActivity" class="mt-3">
                    <input type="hidden" asp-for="Lead.Id" name="leadId" />
                    <div class="input-group">
                        <input type="text" name="action" class="form-control" placeholder="Add note..." required />
                        <button type="submit" class="btn btn-outline-primary">Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
