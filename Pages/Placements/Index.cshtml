@page
@model TrackQR.Web.Pages.Placements.IndexModel
@{
    ViewData["Title"] = "Placements";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div></div>
    <a asp-page="Create" class="btn btn-primary"><i class="fas fa-plus me-1"></i> New Placement</a>
</div>

<div class="card table-card">
    <div class="card-body">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Campaign</th>
                    <th>Location</th>
                    <th>Cost</th>
                    <th>QR Codes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Placements)
                {
                    <tr>
                        <td><strong>@p.Name</strong></td>
                        <td>@p.Campaign.Name</td>
                        <td>@StringHelper.Truncate(p.LocationNote, 40)</td>
                        <td>@(p.Cost?.ToString("N0") ?? "-")</td>
                        <td>@p.QRCodes.Count</td>
                        <td>
                            <a asp-page="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-edit"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
