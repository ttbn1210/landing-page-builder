@page
@model TrackQR.Web.Pages.Placements.CreateModel
@{
    ViewData["Title"] = "Create Placement";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card form-card">
            <h4 class="mb-4">Create New Placement</h4>
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Campaign</label>
                    <select asp-for="CampaignId" class="form-select" asp-items="Model.CampaignOptions" required></select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Placement Name</label>
                    <input asp-for="Name" class="form-control" placeholder="e.g. Car Sticker - Toyota Vios" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Location Note</label>
                    <textarea asp-for="LocationNote" class="form-control" rows="2" placeholder="Where is this placed?"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label">Cost</label>
                    <input asp-for="Cost" type="number" step="0.01" class="form-control" />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create Placement</button>
                    <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
