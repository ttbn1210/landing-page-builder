@page
@model TrackQR.Web.Pages.Campaigns.CreateModel
@{
    ViewData["Title"] = "Create Campaign";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card form-card">
            <h4 class="mb-4">Create New Campaign</h4>
            <form method="post">
                <div class="mb-3">
                    <label class="form-label">Campaign Name</label>
                    <input asp-for="Name" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">Description</label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Start Date</label>
                        <input asp-for="StartDate" type="date" class="form-control" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label">End Date</label>
                        <input asp-for="EndDate" type="date" class="form-control" />
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Budget</label>
                    <input asp-for="Budget" type="number" step="0.01" class="form-control" />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Create Campaign</button>
                    <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
