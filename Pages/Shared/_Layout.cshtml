<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TrackQR</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="d-flex">
        <!-- Sidebar -->
        <nav class="sidebar">
            <div class="sidebar-brand">
                <i class="fas fa-qrcode"></i> TrackQR
            </div>
            <ul class="nav flex-column mt-3">
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Dashboard/Index">
                        <i class="fas fa-tachometer-alt"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Campaigns/Index">
                        <i class="fas fa-bullhorn"></i> Campaigns
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Placements/Index">
                        <i class="fas fa-map-marker-alt"></i> Placements
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/LandingPages/Index">
                        <i class="fas fa-file-alt"></i> Landing Pages
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/QRCodes/Index">
                        <i class="fas fa-qrcode"></i> QR Codes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Leads/Index">
                        <i class="fas fa-user-friends"></i> Leads
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Analytics/Index">
                        <i class="fas fa-chart-bar"></i> Analytics
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Settings/Index">
                        <i class="fas fa-cog"></i> Settings
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Main Content -->
        <div class="main-content flex-grow-1">
            <div class="topbar d-flex justify-content-between align-items-center">
                <h5 class="mb-0">@ViewData["Title"]</h5>
                <div>
                    <span class="text-muted small">TrackQR v1.0</span>
                </div>
            </div>

            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
